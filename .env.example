# ============================================================
# Cyber-Entity — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- LLM Provider ---
# Option A (local, free): ollama  — needs Ollama running on host
# Option B (recommended): anthropic
# Option C (performance): anthropic with claude-sonnet-4-6
ACTIVE_LLM_PROVIDER=anthropic
ACTIVE_LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-xxxxx
DEEPSEEK_API_KEY=
# In Docker, Ollama runs on host: use host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Auth (REQUIRED) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Docker: overridden by docker-compose.yml
# Local dev: uses current directory
DATABASE_URL=sqlite+aiosqlite:///./cyberentity.db

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
# Public URL reachable from Android for HITL action buttons
# With Tailscale: http://<machine-tailscale-ip>:8000
BACKEND_URL=http://localhost:8000
RATE_LIMIT=60/minute

# --- Qdrant vector memory ---
# Docker: auto-configured to http://qdrant:6333
# Local dev: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333

# --- ntfy push notifications (Android HITL) ---
# Docker: auto-configured to http://ntfy:80
# Android app: https://ntfy.sh — subscribe to topic below
# NTFY_URL left empty = push notifications disabled
NTFY_URL=http://localhost:7070
NTFY_TOPIC=cyberentity
NTFY_BASE_URL=http://localhost:7070

# --- TTS voice (edge-tts, requires internet) ---
# French voices: fr-FR-DeniseNeural (F), fr-FR-HenriNeural (M), fr-BE-CharlineNeural (F)
TTS_VOICE=fr-FR-DeniseNeural

# --- Frontend (Docker / remote) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- SSH Keys path (Docker only) ---
SSH_KEYS_PATH=~/.ssh
