# ============================================================
# ELY — Environment Variables
# ============================================================
# Copy this file to .env and fill what you need.
# All variables are OPTIONAL except JWT_SECRET_KEY.
# ============================================================

# ─── Auth (REQUIRED — the app refuses to start with the placeholder value) ───
# Generate with: openssl rand -hex 32   (or python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET_KEY=CHANGE-ME-generate-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Provider — pick one ──────────────────────────────────────────────────
# Default behaviour: Ollama on host (free, 100% local).
# Override per-tier from Settings → Modèles IA UI once first user is created.
ACTIVE_LLM_PROVIDER=ollama
ACTIVE_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Cloud LLM keys (optional — leave empty to disable that provider)
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
# Qwen DashScope (Alibaba Cloud) — region-scoped base URL
QWEN_API_KEY=
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# LM Studio (Apple Silicon MLX) — local OpenAI-compatible server
# Useful for xLAM, Gemma, Qwen Coder etc.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234

# ─── Database ────────────────────────────────────────────────────────────────
# Docker compose overrides this to /app/data/cyberentity.db
DATABASE_URL=sqlite+aiosqlite:///./cyberentity.db

# ─── HTTP server ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
# Public URL reachable from external services (Telegram webhook, Android HITL).
# With Cloudflare Tunnel: https://<your-domain>. Local-only dev: http://localhost:8000
BACKEND_URL=http://localhost:8000
# CORS — comma-separated origins. Use a real list in production, never "*"
CORS_ORIGINS=http://localhost:3000
# Set to true behind HTTPS so JWT cookies have the Secure flag
COOKIE_SECURE=false
RATE_LIMIT=60/minute

# ─── Qdrant vector memory ────────────────────────────────────────────────────
# Docker: auto-configured to http://qdrant:6333
QDRANT_URL=http://localhost:6333

# ─── TTS voice (edge-tts, requires internet) ─────────────────────────────────
# French: fr-FR-DeniseNeural (F), fr-FR-HenriNeural (M), fr-BE-CharlineNeural (F)
TTS_VOICE=fr-FR-DeniseNeural

# ─── Frontend (baked at build time, not changed at runtime) ──────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── SSH Keys (Docker only — see docker-compose.yml volumes) ─────────────────
# DEFAULT (./data/ssh) is intentionally an empty local dir, NOT your ~/.ssh
# To enable SSH actions, copy the keys you want to expose into ./data/ssh/
# and set SSH_KEYS_PATH=~/.ssh if you really want to expose your personal keys
SSH_KEYS_PATH=./data/ssh

# ─── External APIs (optional) ────────────────────────────────────────────────
SERPER_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# ─── Google OAuth (for Gmail/Calendar/Drive integration) ─────────────────────
# Setup: console.cloud.google.com → create OAuth client (Web app)
# Redirect URI: http://localhost:8000/api/google/callback (dev) or your prod URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# ─── Push notifications ──────────────────────────────────────────────────────
# ntfy: free push to Android/iOS via ntfy.sh app. Pick any unguessable URL.
# Generate one: https://ntfy.sh/ + a long random string
NTFY_URL=
# FCM (Firebase Cloud Messaging) for native Android push
# Path to firebase-adminsdk JSON inside the container
FIREBASE_CREDENTIALS_PATH=/config/firebase-adminsdk.json

# ─── Channels (configurable via UI: Settings → Channels) ─────────────────────
# These are templates — production values should be set via the UI which
# stores them encrypted in system_config. .env values are picked up at
# startup as initial defaults if no UI value is saved.

# Telegram bot — create via @BotFather on Telegram, /newbot
TELEGRAM_BOT_TOKEN=
# Force polling mode if BACKEND_URL isn't reachable from Telegram (e.g.
# behind a reverse proxy that doesn't expose /webhook/*).
# TELEGRAM_USE_POLLING=1

# WhatsApp Cloud API (optional — the QR-paired neonize bridge in
# Settings → Channels → WhatsApp doesn't need any of these)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Slack (Socket Mode — both tokens needed)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# ─── Goal-driven Mission heartbeat ───────────────────────────────────────────
# How often (seconds) the mission scheduler picks up due missions.
# Lower = more reactive but more CPU spent on empty beats. Range: 5-300.
MISSION_HEARTBEAT_SECONDS=10
# Cap on missions processed per beat — prevents starvation when the queue
# is large. Increase if you regularly run >5 missions in parallel.
MISSION_MAX_PER_BEAT=5
