# ============================================================
# ELY — Environment Variables
# ============================================================
# Copy this file to .env and fill what you need.
# All variables are OPTIONAL except JWT_SECRET_KEY.
# ============================================================

# ─── Auth (REQUIRED — the app refuses to start with the placeholder value) ───
# Generate with: openssl rand -hex 32   (or python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET_KEY=CHANGE-ME-generate-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
# 15 min (revue 2026-06-10, B-18/D2) : les access tokens ne sont pas révocables
# — seule l'expiration borne un token volé. Le refresh est transparent côté
# frontend, une valeur plus longue affaiblit la décision sans gain d'usage.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Provider — PICK ONE (REQUIRED) ───────────────────────────────────────
#
# ⚠️  ELY ne peut RIEN répondre tant qu'au moins UN provider n'est configuré.
# ⚠️  ELY can't answer ANYTHING until at least ONE provider is configured.
#
# Easiest options (free or cheap to start):
#   1. Gemini (FREE, fastest start) → https://aistudio.google.com/apikey
#      → set GEMINI_API_KEY below + ACTIVE_LLM_PROVIDER=gemini
#   2. Anthropic Claude (5 $ free credits) → https://console.anthropic.com
#      → set ANTHROPIC_API_KEY below + ACTIVE_LLM_PROVIDER=anthropic
#   3. Mistral AI (EU-sovereign, paid) → https://console.mistral.ai
#      → set MISTRAL_API_KEY below + ACTIVE_LLM_PROVIDER=mistral
#   4. Local Ollama (free, 100% offline, needs 5-15 GB RAM per model)
#      → install Ollama on the host: https://ollama.ai
#      → keep ACTIVE_LLM_PROVIDER=ollama (default below)
#
# After first signup, the active provider can be changed per-tier
# (fast/standard/deep/vision) from Settings → Modèles IA in the web UI.
#
ACTIVE_LLM_PROVIDER=ollama
ACTIVE_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Cloud LLM keys (optional — leave empty to disable that provider)
# Fill at least ONE of these if you're not running Ollama locally.
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
# Qwen DashScope (Alibaba Cloud) — region-scoped base URL
QWEN_API_KEY=
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OpenAI (GPT-4o, GPT-5, o1, o3, …) — leave OPENAI_BASE_URL empty for the public API
# (use it only for Azure OpenAI proxies or self-hosted OpenAI-compatible endpoints)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Moonshot AI — Kimi K1.5 / K2 / K2.6 (long-context agentic reasoning models)
# International endpoint by default. China region: https://api.moonshot.cn/v1
# Note: Kimi K2.x accept ONLY temperature=1 — handled automatically in code.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# LM Studio (Apple Silicon MLX) — local OpenAI-compatible server
# Useful for xLAM, Gemma, Qwen Coder etc.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234

# ─── Voie rapide (SLM) — le petit modèle local qui répond aux demandes simples ─
#
# Le routeur d'intention note chaque demande de 0 à 100. Sous le seuil, elle
# part au TIER A ; au-dessus, au tier voulu par le routage. Un tour local ne
# coûte rien et répond en une seconde ou deux au lieu de plusieurs.
#
# Ces quatre variables étaient absentes de ce fichier jusqu'au 22/08 alors que
# `docker-compose.yml` les passe depuis toujours. Chercher un réglage qui
# n'est écrit nulle part coûte une journée — c'est arrivé.
SLM_ENABLED=false

# ⚠️ SLM_MODEL NE CHOISIT PAS LE MODÈLE. C'est le piège de ce bloc.
#
# `get_slm()` rend le TIER A tel que tu l'as configuré dans l'interface
# (Réglages → Routage). SLM_MODEL ne sert QUE de repli, quand aucune instance
# n'est déclarée pour ce tier : on retombe alors sur Ollama avec ce nom.
#
# Autrement dit : pour changer le modèle de la voie rapide, va dans Réglages →
# Routage. Toucher à cette ligne n'aura aucun effet visible, et c'est
# exactement ce qui a fait croire pendant des jours qu'Ely servait un modèle
# qu'il ne servait pas.
#
# ⚠️ Le défaut du compose (qwen2.5:3b-instruct) DIFFÈRE de celui du code
# (qwen2.5:7b-instruct). Le compose gagne, puisqu'il le pose dans
# `environment:`. Un `.env` vide te donne donc le 3b, pas le 7b.
SLM_MODEL=qwen2.5:3b-instruct

# Seuil de bascule, 0-100. Plus haut = plus de demandes traitées en local.
# 40 est prudent ; 55 envoie déjà les salutations et les questions courtes au
# petit modèle. Au-delà, il commence à recevoir des demandes qui le dépassent
# et le repli cloud se déclenche — visible dans l'interface depuis #329.
SLM_COMPLEXITY_THRESHOLD=40

# Délai avant repli vers le cloud, en secondes.
# ⚠️ Ce n'est PAS un réglage de confort : tu attends ce temps AVANT de savoir
# qu'un repli a eu lieu. Trois fois la latence observée de ton modèle est un
# bon ordre de grandeur — 15 à 20 s pour un 4B sur Apple Silicon. Monter à 60
# est une valeur de diagnostic, pas d'usage.
SLM_TIMEOUT=25.0

# ─── Public demo mode (agent-ely.fr) ────────────────────────────────────────
# Set to "true" ONLY on the shared public-demo instance. When enabled :
#   - non-admin users are denied system_get_logs (cross-tenant log isolation)
#   - non-admin users see redacted output from system_check_channels
#     (no global "users_linked=N" count, only "you_linked=true/false")
#   - additional hardening hooks may be added here as the demo evolves
# Default false everywhere else (self-hosted by you = full diagnostic access).
DEMO_MODE=false

# ─── Database ────────────────────────────────────────────────────────────────
# Docker compose overrides this to /app/data/cyberentity.db
DATABASE_URL=sqlite+aiosqlite:///./cyberentity.db

# ─── HTTP server ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ─── Host ports for Docker Compose (change if you already use these) ─────────
# If you already run another project on 3000 / 8000 / 6333 / 80, override here.
# Compose reads them via ${ELY_FRONTEND_PORT:-3000} etc.
# Example for a second ELY install side-by-side:
#   ELY_FRONTEND_PORT=13000
#   ELY_BACKEND_PORT=18000
#   ELY_QDRANT_PORT=16333
#   ELY_HTTP_PORT=18080
ELY_FRONTEND_PORT=3000
ELY_BACKEND_PORT=8000
ELY_QDRANT_PORT=6333
ELY_HTTP_PORT=80
# Public URL reachable from external services (Telegram webhook, Android HITL).
# With Cloudflare Tunnel: https://<your-domain>. Local-only dev: http://localhost:8000
BACKEND_URL=http://localhost:8000
# CORS — comma-separated origins. Use a real list in production, never "*"
CORS_ORIGINS=http://localhost:3000
# Set to true behind HTTPS so JWT cookies have the Secure flag
COOKIE_SECURE=false
RATE_LIMIT=60/minute

# ─── Qdrant vector memory ────────────────────────────────────────────────────
# Docker: auto-configured to http://qdrant:6333
QDRANT_URL=http://localhost:6333

# ─── TTS voice (edge-tts, requires internet) ─────────────────────────────────
# Défaut applicatif : fr-FR-VivienneMultilingualNeural (voix HD naturelle).
# ⚠️ NE PAS épingler ici sauf pour changer de voix — une valeur posée dans le
# .env écrase SILENCIEUSEMENT les futurs défauts du code (piège vécu).
# Autres voix FR : fr-FR-DeniseNeural (F), fr-FR-HenriNeural (M),
# fr-BE-CharlineNeural (F).
# TTS_VOICE=fr-FR-DeniseNeural
# Débit (edge-tts) : défaut applicatif +10% (léger). "+0%" = rythme naturel.
# TTS_RATE=+5%

# ─── Frontend (baked at build time, not changed at runtime) ──────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── SSH Keys (Docker only — see docker-compose.yml volumes) ─────────────────
# DEFAULT (./data/ssh) is intentionally an empty local dir, NOT your ~/.ssh
# To enable SSH actions, copy the keys you want to expose into ./data/ssh/
# and set SSH_KEYS_PATH=~/.ssh if you really want to expose your personal keys
SSH_KEYS_PATH=./data/ssh

# ─── Recherche web ───────────────────────────────────────────────────────────
#
# La chaîne : SearXNG → Serper → SearchCans → Google CSE → Tavily → DuckDuckGo.
# Un fournisseur qui échoue OU qui ne rend rien passe la main au suivant.
#
# SearXNG est AUTO-HÉBERGÉ (service `searxng` du docker-compose) : pas de clé,
# pas de quota. Il est en tête pour que les crédits gratuits des autres
# deviennent un filet, pas l'ordinaire.
#   • Laisser SEARXNG_URL vide DÉSACTIVE SearXNG (il ne sera pas appelé).
#   • SEARXNG_SECRET est obligatoire au démarrage du conteneur :
#       openssl rand -hex 32
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=

# Fournisseurs à crédits, en repli. Tous facultatifs.
#
# Exa fait de la recherche SÉMANTIQUE (pas du mot-clé) : il apporte un angle
# que les autres n'ont pas. Placé juste derrière SearXNG, il n'est appelé que
# si celui-ci ne rend rien. https://dashboard.exa.ai/api-keys
EXA_API_KEY=
SERPER_API_KEY=
SEARCHCANS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
TAVILY_API_KEY=

# ─── Autres API externes (optionnel) ─────────────────────────────────────────
YOUTUBE_API_KEY=

# ─── Google OAuth (for Gmail/Calendar/Drive integration) ─────────────────────
# Setup: console.cloud.google.com → create OAuth client (Web app)
# Redirect URI: http://localhost:8000/api/google/callback (dev) or your prod URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# ─── Push notifications ──────────────────────────────────────────────────────
# ntfy: free push to Android/iOS via ntfy.sh app. Pick any unguessable URL.
# Generate one: https://ntfy.sh/ + a long random string
NTFY_URL=
# FCM (Firebase Cloud Messaging) for native Android push
# Path to firebase-adminsdk JSON inside the container
FIREBASE_CREDENTIALS_PATH=/config/firebase-adminsdk.json

# ─── Channels (configurable via UI: Settings → Channels) ─────────────────────
# These are templates — production values should be set via the UI which
# stores them encrypted in system_config. .env values are picked up at
# startup as initial defaults if no UI value is saved.

# Telegram bot — create via @BotFather on Telegram, /newbot
TELEGRAM_BOT_TOKEN=
# Force polling mode if BACKEND_URL isn't reachable from Telegram (e.g.
# behind a reverse proxy that doesn't expose /webhook/*).
# TELEGRAM_USE_POLLING=1

# WhatsApp Cloud API (optional — the QR-paired neonize bridge in
# Settings → Channels → WhatsApp doesn't need any of these)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Slack (Socket Mode — both tokens needed)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# ─── Goal-driven Mission heartbeat ───────────────────────────────────────────
# How often (seconds) the mission scheduler picks up due missions.
# Lower = more reactive but more CPU spent on empty beats. Range: 5-300.
MISSION_HEARTBEAT_SECONDS=10
# Cap on missions processed per beat — prevents starvation when the queue
# is large. Increase if you regularly run >5 missions in parallel.
MISSION_MAX_PER_BEAT=5

# ─── GitHub tools (stats repo, trafic, notifications) ────────────────────────
# Token PAT pour les outils GitHub d'Ely (github_repo_stats, github_traffic_
# stats, github_notifications — lecture uniquement). Classic token, scopes
# minimaux : public_repo + notifications (repo si dépôts privés).
# NB : indépendant du token de GRADUATION (system_config, chiffré) — deux
# métiers, deux périmètres, deux rayons d'explosion.
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# ─── Outils Python appris (auto-developing agent) ────────────────────────────
# Outils PURS (calcul/composition, sans réseau) que l'agent s'écrit lui-même :
# génération → validation 7 étages → revue admin → promotion → binding.
# Exécution in-process. Défaut OFF.
LEARNED_PYTHON_TOOLS_ENABLED=false
# Outils io (profil V3) : autorise les outils Python QUE L'AGENT S'ÉCRIT à
# faire du VRAI réseau — exécutés exclusivement dans la sandbox isolée
# (rootfs lecture seule, egress limité aux domaines de sandbox/squid.conf,
# secrets Vault injectés à l'appel, 256 Mio / 10 s CPU par run).
# Gardes : validation 7 étages → revue admin du périmètre (domaines/deps/
# secrets) → promotion manuelle → 10 premiers appels sous HITL (canary).
# Coût au repos : nul (les conteneurs sandbox/proxy tournent déjà via
# compose) — seul chaque appel io consomme.
# Nouveau domaine d'API = l'ajouter à sandbox/squid.conf + rebuild sandbox.
LEARNED_PYTHON_TOOLS_IO_ENABLED=false

# ─── PII NER layer 2 (anonymisation noms/orgs/adresses — défaut OFF) ─────────
# Couche 2 du SecurityFilter : GLiNER (urchade/gliner_multi_pii-v1) en ONNX
# détecte les personnes / organisations / adresses postales dans le texte
# QUE VOUS TAPEZ, avant tout envoi à un LLM cloud (emails/téléphones/IBAN/CB
# restent couverts par la couche 1 regex, toujours active). Périmètre calibré
# terrain : villes/régions/pays en clair (seul le niveau rue est masqué),
# services intégrés (GitHub, Gmail…) jamais masqués, résultats d'outils non
# re-détectés (votre PII connue y reste masquée). Activation en 3 étapes :
#   1. PII_NER_INSTALL=1 ici, puis `docker compose build backend`
#      (embarque gliner+torch dans l'image, ~800 Mo) — GARDER ce flag ensuite
#   2. exporter le modèle ONNX sur l'HÔTE (jamais dans le conteneur) :
#      voir l'en-tête de backend/scripts/export_gliner_onnx.py
#   3. PII_NER_ENABLED=true ici, puis `docker compose up -d backend`
#
# 🔴 KILL-SWITCH — si la couche masque trop et gêne l'usage :
#   PII_NER_ENABLED=false puis `docker compose up -d backend` (recreate
#   obligatoire : un simple `restart` ne relit PAS les variables d'env).
#   Aucune perte : la couche 1 regex reste active. Voir docs/security.md
#   et docs/TROUBLESHOOTING.md.
PII_NER_INSTALL=0
PII_NER_ENABLED=false
# Termes à ne JAMAIS masquer, en plus des services intégrés par défaut :
# PII_NER_ALLOWLIST="MonEntreprise,MonProduit"
# Plafond de couverture NER par texte (latence ~160 ms / 1000 caractères) —
# au-delà, seules les regex couche 1 couvrent la fin du texte.
# PII_NER_MAX_CHARS=8000

# Plafond de tours (LangGraph recursion_limit) d'une tâche planifiée.
# Défaut 60. Les tâches multi-étapes lourdes (ex: prospection multi-cibles)
# gagnent à être restructurées en mission foreach plutôt qu'à monter ce seuil.
# SCHEDULER_RECURSION_LIMIT=60

# ─── Client MCP v2 — Ely se connecte à des serveurs MCP externes (défaut OFF) ─
# Permet à Ely de se connecter, à la demande, à des serveurs Model Context
# Protocol (MCP) externes, de découvrir leurs outils et de les utiliser :
# outils pilotés par le modèle (mcp_connect / mcp_discover_tools / mcp_call_tool),
# connexion autonome aux serveurs HTTPS distants, serveurs locaux (stdio) mis en
# QUARANTAINE pour validation humaine, ACL + confirmation HITL par outil, secrets
# stockés dans le Vault, garde anti-SSRF. OFF par défaut. Une fois activé,
# l'accès est réservé à l'ADMIN le temps de valider en réel (« canary »), puis
# ouvrable par utilisateur. Le kill-switch par serveur est TOUJOURS respecté.
MCP_CLIENT_V2_ENABLED=false
# MCP v2 — briques optionnelles, chacune derrière son flag (OFF par défaut) :
# connexion OAuth 2.1/PKCE aux serveurs distants, sandbox (rlimits + cwd) pour
# les serveurs stdio locaux, exposition lecture seule des resources/prompts.
MCP_OAUTH_ENABLED=false
MCP_STDIO_SANDBOX_ENABLED=false
MCP_RESOURCES_ENABLED=false
# Registre MCP officiel pour rechercher / auto-remplir une config de serveur.
# Recherche et DÉCOUVERTE uniquement — aucune connexion ni confiance implicite.
# MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io

# ─── Substrat de confiance (couche EXPÉRIMENTALE — défaut OFF) ────────────────
# Interrupteur maître d'une couche interne avancée : manifestes de capacités
# (CapabilityManifest), plans d'action signés + empreinte, idempotence (rejouer
# une action identique dans la fenêtre renvoie le résultat mémorisé au lieu de la
# ré-exécuter) et bus d'événements typés. Tant qu'il est OFF, le comportement
# actuel (confirmations HITL / ACL) est strictement préservé. Réservé au
# développement / aux tests — laisse OFF en usage normal.
TRUST_SUBSTRATE_ENABLED=false
# Fenêtre d'idempotence (secondes) : délai pendant lequel une action « supportée »
# identique re-jouée renvoie le résultat mémorisé. Sans effet si OFF ci-dessus.
# IDEMPOTENCY_TTL_SECONDS=600
# Export OpenTelemetry des événements typés (nécessite le SDK opentelemetry).
# OTEL_ENABLED=false
# Reversible Action Journal : rend exécutable la « compensation » du substrat →
# Ely peut ANNULER une action mutante qu'elle vient de faire (ex. ressortir de la
# corbeille un fichier Drive supprimé). Quand ON, chaque action annulable est
# journalisée après succès, et l'agent gagne les outils « annule ce que tu viens
# de faire » (undo_last_action / revert_action) + l'API /api/me/reversible-actions.
# OFF par défaut ; active en « canary » pour valider en réel. NÉCESSITE
# TRUST_SUBSTRATE_ENABLED=true pour que les actions soient enregistrées.
REVERSIBLE_JOURNAL_ENABLED=false
# Fenêtre d'annulation (secondes) au-delà de laquelle une action n'est plus
# annulable (« expired »). Défaut 7 jours, < les ~30 j de la corbeille Drive.
# REVERSIBLE_JOURNAL_TTL_SECONDS=604800

# ── Missions autonomes (mandat d'autonomie) ────────────────────────────────
# Autonomie PAR MISSION dans un mandat validé une fois par l'humain :
# familles d'outils autorisées + noyau interdit dur (ssh, admin, secrets…),
# disjoncteurs journaliers (500 actions / 100 appels LLM), pause propre +
# reprise, workspace + carnet de bord, anti-boucle. OFF par défaut : le
# moteur reste dormant tant que le flag n'est pas activé ET qu'un mandat
# n'a pas été validé dans l'UI. Pré-requis conseillé :
# REVERSIBLE_JOURNAL_ENABLED=true (actions annulables).
AUTONOMOUS_MISSIONS_ENABLED=false

# ── Échéances murales par appel LLM (C3d-2) ────────────────────────────────
# Bornes TOTALES (secondes) par appel LLM — asyncio.wait_for autour de chaque
# ainvoke. Les timeouts httpx des clients sont PAR LECTURE réseau : un stream
# qui goutte ne les déclenche jamais (pendaison réelle de 907 s observée le
# 18/07/2026). Une échéance dépassée est classée TIMEOUT → la rotation de
# chaîne de fallback prend le relais automatiquement. Défauts raisonnables —
# ne toucher que si un provider lent légitime dépasse la borne.
LLM_DEADLINE_SIMPLE_S=30
LLM_DEADLINE_MEDIUM_S=120
LLM_DEADLINE_COMPLEX_S=240
LLM_DEADLINE_MISSION_ACT_S=180
LLM_DEADLINE_ROUTER_S=10

# ── Auto-génération d'outils sur capacité manquante (C4-2) ─────────────────
# Quand find_tool ne trouve RIEN dans tout le catalogue, le gap est consigné
# (Capacités manquantes) et la génération d'un outil candidat démarre toute
# seule (tier-S). Garde-fous : pré-check sémantique anti-doublon, une
# tentative par gap et par boot, et la sortie est TOUJOURS une candidate —
# la promotion reste un geste humain (Compétences à valider), l'outil n'est
# bindable qu'une fois promu ET LEARNED_PYTHON_TOOLS_ENABLED actif.
# Une notification ntfy part quand une candidate attend validation.
AUTO_TOOL_GENERATION_ENABLED=true

# ── Outils longs : bascule en tâche de fond ────────────────────────────────
# Un outil qui dépasse ce budget DANS UN CHAT n'est pas tué : il continue en
# arrière-plan, Ely le dit à l'utilisateur, et le résultat est livré à
# l'arrivée (message dans la conversation + notification + reprise du travail
# pour finir la demande). Incident fondateur : une traduction de PDF de 395
# pages a tourné 2 h 52 dans un tour de chat et le résultat a été perdu.
# Les missions et les tâches planifiées ne basculent jamais.
LONG_TOOL_HANDOFF_ENABLED=true
LONG_TOOL_SOFT_DEADLINE_S=90

# ── Anticipation (C5) ──────────────────────────────────────────────────────
# Cron hebdo (mardi 03:00 UTC) : détecte les demandes récurrentes (mêmes
# mots, cadence régulière sur 28 j) et PROPOSE d'en faire une tâche
# planifiée (push ntfy + panneau /api/me/suggestions). Ely ne crée JAMAIS
# la tâche elle-même ; un refus est définitif (jamais re-proposé).
# ANTICIPATION_DISABLED=true

# ── Injection des skills appris (C4-3) ─────────────────────────────────────
# Fenêtre de grâce : un skill promu depuis moins de N jours est TOUJOURS
# injecté dans le prompt (tag « (nouveau) »), même avec use_count=0 — sans
# elle, un outil fraîchement validé était le premier coupé du top-20 trié
# par usage (cold-start). Au-delà du cap, les places restantes vont aux
# skills pertinents pour la demande courante (lexical + cosine best-effort).
LEARNED_SKILLS_GRACE_DAYS=7
