*.db-wal
*.db-shm

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Alembic
alembic/versions/__pycache__/

# Docker / data
data/*.db
TO_DELETE/

# Artefacts de build Android — les deux arbres sont archives sous
# archive/mobile/ depuis le 02/09/2026 (voir archive/README.md). Les motifs
# suivent le chemin d'archive pour qu'un reveil ne recommite pas de build.
archive/mobile/**/.gradle/
archive/mobile/**/.kotlin/
archive/mobile/**/build/
archive/mobile/**/local.properties
*.apk
*.aab

# Claude
.claude/
/memory/

# Secrets Firebase — NE PAS COMMITER
backend/firebase/
archive/mobile/**/google-services.json
*.json.secret
*-firebase-adminsdk-*.json
.aider*
.mcp.json

# Runtime data (should never be committed)
# Using /data/ anchor to avoid matching the Kotlin `data` package under
# archive/mobile/.../com/ely/agent/data/
/data/
/logs/
# Exception : track the empty data/ssh placeholder so the docker-compose
# SSH-keys mount doesn't fail on fresh clones (default mount target).
!/data/ssh/
!/data/ssh/.gitkeep

# Next.js / TypeScript build artifacts
frontend/tsconfig.tsbuildinfo

# Couverture pytest. Depuis que la CI lance `pytest --cov` (02/09/2026), le
# moindre run local depose backend/.coverage et le fait apparaitre dans
# `git status`. C'est une mesure d'execution, pas une source.
.coverage
.coverage.*
htmlcov/

# Test runner logs (keep in test-runner/ only, not at repo root)
/*.log
/hitl-*.log
/smoke-*.log
/run-*.log

# Test runner transient outputs
test-runner/run*.log
test-runner/hitl*.log
test-runner/smoke*.log
test-runner/cleanup*.log

# Local backups created by manual edits (jamais commiter — peuvent contenir
# secrets ou versions intermédiaires)
*.bak
*.bak.*
*.backup
*~

# Reports & ad-hoc analyses
gemini-report.md
*-report.md

# Private documents — NEVER commit (proof of authorship, IP enforcement, etc.)
*.private.md
.canaries.*

