# Backup directories (sometimes created when debugging)
TO_DELETE/
*.bak.20*
*.tar.gz

# ELY Desktop binaries — too large for git (~5 MB each), distributed via
# GitHub Releases attached to each tag. Keep the dist/ folder placeholder so
# Docker volume mount doesn't fail on a fresh clone before binaries are built.
desktop/dist/*
!desktop/dist/.gitkeep
# ... et le binaire posé à la racine de desktop/ par un `go build` sans -o
desktop/ely-desktop

# Canonical bench artefacts — produced at run-time, not source-of-truth
bench/results/

# Documentation interne / confidentielle — cadrages, audits, notes privées.
# JAMAIS publié sur GitHub (repo public). Voir docs/ pour la doc publique.
docs_internes/
