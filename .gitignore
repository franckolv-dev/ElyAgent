# Runtime data (should never be committed)
# Using /data/ anchor to avoid matching android/.../data/ (Kotlin package)
/data/
/logs/
# Exception : track the empty data/ssh placeholder so the docker-compose
# SSH-keys mount doesn't fail on fresh clones (default mount target).
!/data/ssh/
!/data/ssh/.gitkeep

# Next.js / TypeScript build artifacts
frontend/tsconfig.tsbuildinfo

# Test runner logs (keep in test-runner/ only, not at repo root)
/*.log
/hitl-*.log
/smoke-*.log
/run-*.log

# Test runner transient outputs
test-runner/run*.log
test-runner/hitl*.log
test-runner/smoke*.log
test-runner/cleanup*.log

# Local backups created by manual edits (jamais commiter — peuvent contenir
# secrets ou versions intermédiaires)
*.bak
*.bak.*
*.backup
*~

# Reports & ad-hoc analyses
gemini-report.md
*-report.md

# Private documents — NEVER commit (proof of authorship, IP enforcement, etc.)
*.private.md
.canaries.*

